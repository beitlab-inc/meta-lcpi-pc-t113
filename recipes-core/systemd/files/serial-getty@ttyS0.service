[Unit]
Description=Serial Getty on %I
Documentation=man:agetty(8) man:systemd-getty-generator(8)
After=systemd-user-sessions.service plymouth-quit-wait.service
After=rc-local.service
After=dev-%i.device
Requires=dev-%i.device

[Service]
ExecStart=-/sbin/agetty --keep-baud 115200,38400,9600 %I $TERM
Type=idle
Restart=always
UtmpIdentifier=%I
TTYPath=/dev/%I
# Do not hang up PB6/PB7 when a game stops the LCD getty (or mistakenly
# Conflicts with this unit). TTYVHangup=yes SIGHUPs the login shell and
# the UART looks "blocked" until reboot.
TTYReset=no
TTYVHangup=no
KillMode=process
IgnoreSIGPIPE=no
SendSIGHUP=no

[Install]
WantedBy=getty.target
