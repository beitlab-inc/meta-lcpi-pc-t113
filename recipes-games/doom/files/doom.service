[Unit]
Description=Doom on the LCD (framebuffer, Freedoom)
# Own the LCD VT only. Never Conflict with serial-getty@ttyS0: that unit's
# TTYVHangup=yes would hang up PB6/PB7 (UART3 / ttyS0) and freeze the shell.
Conflicts=getty@tty1.service
After=systemd-user-sessions.service getty@tty1.service
After=psplash-start.service psplash-systemd.service
Wants=alsa-unmute.service
After=alsa-unmute.service
After=boot-chime.service

[Service]
Type=simple
StandardInput=null
StandardOutput=journal
StandardError=journal
TTYReset=no
TTYVHangup=no
ExecStartPre=-/usr/bin/psplash-write "QUIT"
ExecStartPre=-/bin/sleep 1
ExecStartPre=-/usr/bin/amixer -q sset 'Headphone' on
ExecStartPre=-/usr/bin/amixer -q sset 'Headphone' 100%
ExecStartPre=-/usr/bin/amixer -q sset 'DAC' 100%
Environment=DOOMWADDIR=/usr/share/games/doom
WorkingDirectory=/usr/share/games/doom
ExecStart=/usr/bin/game --run doom /usr/bin/doomgeneric -iwad /usr/share/games/doom/freedoom1.wad
ExecStopPost=-/usr/bin/game --restore-console
Restart=no

[Install]
WantedBy=multi-user.target
